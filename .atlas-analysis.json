  "keyFeatures": [
    "Archetype ECS with numpy structured array storage and struct-of-arrays layout",
    "ModernGL-based 2D sprite batcher and 3D PBR renderer",
    "2D physics via pymunk and 3D physics via pybullet",
    "Typed event bus cleared each frame",
    "Asset hot reload via watchdog file watcher",
    "Text rendering with freetype-py and a bundled fallback font",
    "Audio engine backed by miniaudio",
    "Gamepad support via GLFW",
    "CLI scaffold and hot-reload dev loop",
    "ImGui world inspector, frame profiler, and 2D debug draw"
  ],
